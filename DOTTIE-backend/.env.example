# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server
PORT=3000
NODE_ENV=production

# Admin email addresses (comma-separated) — users with these emails
# automatically receive the "admin" role during registration and Google OAuth.
# Case-insensitive, whitespace is trimmed.
ADMIN_EMAILS=admin@DOTTIE.YZ.rw,manager@test.com

# CORS Allowed Origins (comma-separated)
CORS_ORIGIN=https://DOTTIE.YZrw.netlify.app,http://localhost:3000

# Frontend URL (primary)
FRONTEND_URL=https://DOTTIE.YZrw.netlify.app

# Cloudflare Pages URL (optional)
CLOUDFLARE_PAGES_URL=https://your-project.pages.dev
