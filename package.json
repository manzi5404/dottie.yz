{
  "name": "dottieyz-web",
  "version": "1.0.0",
  "type": "module",
  "description": "DOTTIE.YZ Premium Streetwear Ecommerce",
  "main": "DOTTIE-backend/server.js",
  "scripts": {
    "start": "node DOTTIE-backend/server.js",
    "dev": "vite",
    "build": "node -e \"const{execSync}=require('child_process');const root=execSync('git rev-parse --show-toplevel').toString().trim();execSync('node '+root+'/node_modules/vite/bin/vite.js build',{stdio:'inherit'});execSync('node '+root+'/node_modules/vite/bin/vite.js build --config '+root+'/frontend/src/admin/drops/vite.config.js',{stdio:'inherit'});\"",
    "build:frontend": "node -e \"const{execSync}=require('child_process');const root=execSync('git rev-parse --show-toplevel').toString().trim();execSync('node '+root+'/node_modules/vite/bin/vite.js build',{stdio:'inherit'});\"",
    "build:admin": "node -e \"const{execSync}=require('child_process');const root=execSync('git rev-parse --show-toplevel').toString().trim();execSync('node '+root+'/node_modules/vite/bin/vite.js build --config '+root+'/frontend/src/admin/drops/vite.config.js',{stdio:'inherit'});\"",
    "preview": "vite preview",
    "backend": "nodemon DOTTIE-backend/server.js",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.9",
    "alpinejs": "^3.13.3",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "framer-motion": "^11.0.8",
    "gsap": "^3.12.5",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.0.2",
    "mysql": "^2.18.1",
    "nodemailer": "^6.9.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "autoprefixer": "^10.4.17",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0"
  }
}
